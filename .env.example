# Copy to .env and restart npm start. Keys stay on the local server.
# IMAGE_PROVIDER=vision-script reuses the workspace vision.js configuration.
IMAGE_PROVIDER=vision-script
# IMAGE_API_STYLE=images: /images/generations + /images/edits (multipart)
# IMAGE_API_STYLE=chat: /chat/completions returning actual image content
# IMAGE_API_STYLE=dashscope: native Qwen image generation/editing
# auto selects DashScope for Qwen Image 2.0 on Alibaba Cloud; otherwise images.
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_API_STYLE=auto
# Optional provider-supported size, e.g. 1024x1024 or 1536x1024.
# Never assume the original site's 1K/2K/4K prices or sizes apply to your model.
IMAGE_SIZE=
IMAGE_TIMEOUT_MS=240000
# Only for a trusted local model server which needs no authentication:
IMAGE_ALLOW_NO_KEY=false

CHAT_BASE_URL=
CHAT_PROVIDER=vision-script
CHAT_API_KEY=
CHAT_MODEL=
CHAT_TIMEOUT_MS=90000
CHAT_VISION=false
CHAT_ALLOW_NO_KEY=false

# Real parametric CAD from the user-provided create-3d-things project, extended
# with lathe/extrude/tube/capsule/roundedBox primitives and mirror/array nodes.
# Defaults to the CHAT_BASE_URL / CHAT_API_KEY / CHAT_MODEL above.
# Choose a vision-capable chat model for image and multiview inputs.
MODEL3D_PROVIDER=qwen-cad
MODEL3D_BASE_URL=
MODEL3D_API_KEY=
MODEL3D_MODEL=
# Per-call timeout; the multi-stage pipeline allows up to 5x this overall.
MODEL3D_TIMEOUT_MS=180000
MODEL3D_ALLOW_NO_KEY=false
# Render-and-self-critique rounds after the first build (0-2). 0 disables the
# visual feedback loop; each round adds one vision call plus a local render.
MODEL3D_REFINE_ROUNDS=1
# Structured image analysis before building (image/multiview modes only).
MODEL3D_ANALYZE=true
# Output token budget for the build/critique calls (complex models need more).
MODEL3D_MAX_TOKENS=16000
# Relief uses the local CPU depth model installed by npm run setup:geometry.
